<?xml version="1.0" encoding="utf-8"?>
<!-- Designed for 1024x600 landscape head units -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Left dock: clock + app icons, CarPlay style -->
    <LinearLayout
        android:layout_width="@dimen/dock_width"
        android:layout_height="match_parent"
        android:background="@drawable/dock_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tile_waze"
            style="@style/DockIcon"
            android:background="@drawable/icon_bg_waze"
            android:contentDescription="@string/tile_waze"
            android:src="@drawable/ic_waze" />

        <ImageView
            android:id="@+id/tile_spotify"
            style="@style/DockIcon"
            android:background="@drawable/icon_bg_spotify"
            android:contentDescription="@string/tile_spotify"
            android:src="@drawable/ic_spotify" />

        <ImageView
            android:id="@+id/tile_phone"
            style="@style/DockIcon"
            android:background="@drawable/icon_bg_phone"
            android:contentDescription="@string/tile_phone"
            android:src="@drawable/ic_phone" />

        <ImageView
            android:id="@+id/tile_messages"
            style="@style/DockIcon"
            android:background="@drawable/icon_bg_messages"
            android:contentDescription="@string/tile_messages"
            android:src="@drawable/ic_messages" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_apps"
            style="@style/DockIcon"
            android:background="@drawable/icon_bg_apps"
            android:contentDescription="@string/all_apps"
            android:src="@drawable/ic_apps" />
    </LinearLayout>

    <!-- Main card: the car -->
    <FrameLayout
        android:id="@+id/car_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/car_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/car_options"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/car_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:text="@string/default_car_name"
                    android:textColor="@color/text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- PLK badge: opens PLK in Spotify -->
                <TextView
                    android:id="@+id/badge_plk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/badge_plk"
                    android:clickable="true"
                    android:focusable="true"
                    android:letterSpacing="0.15"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/plk"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Right column: big clock + big CarPlay button -->
    <LinearLayout
        android:layout_width="@dimen/right_column"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/clock_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE d MMM"
                android:format24Hour="EEE d MMM"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_carplay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:background="@drawable/icon_bg_carplay"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/tile_carplay"
                android:src="@drawable/ic_car" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tile_carplay"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/carplay_hint"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
