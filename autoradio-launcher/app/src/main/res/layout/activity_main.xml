<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top bar: clock + date (TextClock updates itself once a minute, no polling) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="56sp" />

        <TextClock
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:paddingStart="20dp"
            android:textColor="@color/text_dim"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btn_apps"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/all_apps"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 5 big tiles, readable at arm's length -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tile_waze"
            style="@style/Tile"
            android:drawableTop="@drawable/ic_waze"
            android:text="@string/tile_waze" />

        <TextView
            android:id="@+id/tile_spotify"
            style="@style/Tile"
            android:drawableTop="@drawable/ic_spotify"
            android:text="@string/tile_spotify" />

        <TextView
            android:id="@+id/tile_phone"
            style="@style/Tile"
            android:drawableTop="@drawable/ic_phone"
            android:text="@string/tile_phone" />

        <TextView
            android:id="@+id/tile_messages"
            style="@style/Tile"
            android:drawableTop="@drawable/ic_messages"
            android:text="@string/tile_messages" />

        <TextView
            android:id="@+id/tile_carplay"
            style="@style/Tile"
            android:drawableTop="@drawable/ic_car"
            android:text="@string/tile_carplay" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="@string/hint"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>
