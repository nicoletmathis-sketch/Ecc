<?xml version="1.0" encoding="utf-8"?>
<!-- CarPlay-style home for 1024x600 landscape head units.
     Card and icon backgrounds are generated in code (see Ui.java). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <!-- ===== Sidebar (always visible) ===== -->
    <LinearLayout
        android:layout_width="@dimen/side_width"
        android:layout_height="match_parent"
        android:background="@color/sidebar"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <TextClock
            android:id="@+id/clock"
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/net"
            style="@style/Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/side_waze"
            style="@style/SideIcon"
            android:contentDescription="@string/tile_waze"
            android:src="@drawable/ic_nav" />

        <ImageView
            android:id="@+id/side_spotify"
            style="@style/SideIcon"
            android:contentDescription="@string/tile_spotify"
            android:src="@drawable/ic_music" />

        <ImageView
            android:id="@+id/side_phone"
            style="@style/SideIcon"
            android:contentDescription="@string/tile_phone"
            android:src="@drawable/ic_phone" />

        <ImageView
            android:id="@+id/side_messages"
            style="@style/SideIcon"
            android:contentDescription="@string/tile_messages"
            android:src="@drawable/ic_messages" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/side_switch"
            style="@style/SideIcon"
            android:contentDescription="@string/switch_page"
            android:src="@drawable/ic_grid" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/separator" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- ===== Page 1: dashboard ===== -->
        <LinearLayout
            android:id="@+id/page_dash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="@dimen/gap">

            <!-- Hero: greeting, clock, weather, car + figurine -->
            <FrameLayout
                android:id="@+id/hero"
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25">

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="@dimen/hero_image_top"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="@string/car_options"
                    android:scaleType="fitEnd" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp">

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextClock
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="HH:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:textSize="@dimen/hero_clock" />

                    <TextClock
                        style="@style/Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEEE d MMMM"
                        android:format24Hour="EEEE d MMMM"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/car_name"
                            style="@style/Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_car_name"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/badge_plk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/badge_plk"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.15"
                            android:paddingStart="6dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="6dp"
                            android:paddingBottom="1dp"
                            android:text="@string/plk"
                            android:textColor="#000000"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Weather, top-right -->
                <LinearLayout
                    android:id="@+id/weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/wx_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/wx_none"
                            android:src="@drawable/ic_wx_partly" />

                        <TextView
                            android:id="@+id/wx_temp"
                            style="@style/Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/speed_none"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/wx_desc"
                        style="@style/Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wx_none"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/wx_range"
                        style="@style/Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Right column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Now playing -->
                <LinearLayout
                    android:id="@+id/media_card"
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/media_art"
                            android:layout_width="@dimen/art"
                            android:layout_height="@dimen/art"
                            android:contentDescription="@string/tile_spotify"
                            android:padding="18dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_note" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/media_title"
                                style="@style/Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/media_idle_title"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/media_artist"
                                style="@style/Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/media_idle_artist"
                                android:textColor="@color/music_red"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/media_source"
                                style="@style/Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/media_progress"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="12dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_bar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/media_elapsed"
                            style="@style/Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/media_remaining"
                            style="@style/Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/media_prev"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:contentDescription="@string/media_prev"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_prev" />

                        <ImageView
                            android:id="@+id/media_play"
                            android:layout_width="72dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"
                            android:clickable="true"
                            android:contentDescription="@string/media_play_pause"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_play" />

                        <ImageView
                            android:id="@+id/media_next"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:contentDescription="@string/media_next"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Home / Work -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/fav_home"
                        layout="@layout/mini_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/fav_work"
                        layout="@layout/mini_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Speed + CarPlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/gap"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/speed_card"
                        style="@style/Card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/speed_value"
                            style="@style/Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.04"
                            android:text="@string/speed_none"
                            android:textSize="@dimen/speed_text" />

                        <TextView
                            style="@style/Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/speed_unit"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/speed_heading"
                            style="@style/Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:singleLine="false"
                            android:textColor="@color/blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/carplay_card"
                        style="@style/Card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/gap"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/carplay_icon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:contentDescription="@string/tile_carplay"
                            android:padding="13dp"
                            android:src="@drawable/ic_carplay" />

                        <TextView
                            android:id="@+id/carplay_button"
                            style="@style/Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:paddingStart="18dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="8dp"
                            android:text="@string/tile_carplay"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/carplay_hint"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Page 2: app grid (cells are built in code) ===== -->
        <FrameLayout
            android:id="@+id/page_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="40dp" />
        </FrameLayout>

        <!-- Page dots -->
        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:padding="6dp" />
    </FrameLayout>
</LinearLayout>
