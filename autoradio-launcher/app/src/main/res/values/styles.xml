<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain black, no wallpaper, no window animations: cheapest possible to draw -->
    <style name="LauncherTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SideIcon">
        <item name="android:layout_width">@dimen/side_icon</item>
        <item name="android:layout_height">@dimen/side_icon</item>
        <item name="android:layout_marginTop">@dimen/side_gap</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Secondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
